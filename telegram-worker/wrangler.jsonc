{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monoskin-telegram",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://xott69.github.io"
  },
  "secrets": {
    "required": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "TURNSTILE_SECRET_KEY"]
  }
}
