{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monoskin-telegram",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://xott69.github.io",
    "TURNSTILE_HOSTNAME": "xott69.github.io",
    "GITHUB_REPOSITORY": "XOTT69/monoskin",
    "GITHUB_BRANCH": "main"
  },
  "kv_namespaces": [
    {
      "binding": "BOT_SESSIONS",
      "id": "dc30179f583046c48b82fb87064b8f5e"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "secrets": {
    "required": ["TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "TURNSTILE_SECRET_KEY", "TELEGRAM_WEBHOOK_SECRET", "GITHUB_TOKEN"]
  }
}
